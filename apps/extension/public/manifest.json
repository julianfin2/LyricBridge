{
  "manifest_version": 3,
  "name": "LyricBridge YouTube 歌词同步",
  "description": "将 YouTube 播放进度发送到 LyricBridge 桌面端。",
  "version": "0.1.1",
  "action": {
    "default_title": "LyricBridge",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*"]
}
