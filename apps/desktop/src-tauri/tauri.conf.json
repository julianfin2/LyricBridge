{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyricBridge",
  "mainBinaryName": "LyricBridge",
  "version": "0.1.0",
  "identifier": "top.volan.lyricbridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LyricBridge",
        "width": 1140,
        "height": 820
      },
      {
        "label": "lyrics",
        "url": "index.html?window=lyrics",
        "title": "LyricBridge Lyrics",
        "width": 1000,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "publisher": "Julian F.",
    "copyright": "Licensed under the MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
